{
  "name": "entelisteam/lbaf-rector",
  "description": "Recursive search for rector rules among dependencies",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "rector"
  ],
  "authors": [
    {
      "name": "ENTELISTEAM INC",
      "email": "welcome@entelis.team",
      "homepage": "https://entelis.team"
    }
  ],
  "require": {
    "php": "~8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "rector/rector": "^2.3.0"
  },
  "autoload": {
    "psr-4": {
      "EntelisTeam\\Lbaf\\Rector\\": "src/",
      "EntelisTeam\\Lbaf\\Rector\\Rector\\": "rector/"
    }
  },
  "extra": {
    "lbaf-rector-migrations": "EntelisTeam\\Lbaf\\Rector\\Rector\\MigrationList"
  },
  "autoload-dev": {
    "psr-4": {
      "EntelisTeam\\Lbaf\\Rector\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --display-warnings",
    "rector-check": "vendor/bin/rector process --dry-run",
    "rector-fix": "vendor/bin/rector process"
  },
  "minimum-stability": "dev"
}
